# ============================================================
#  敏感信息与运行时数据 —— 绝不提交
# ============================================================

# GUI 运行时数据：内含登录账号记录(last_login)、代理地址、任务历史、下载配置。
# 属于个人数据，且每台机器不同，不纳入版本管理。
gui/data/

# 下载目录与中断的临时文件（含已下载内容）
gui/downloads/
*.part
*.part.json

# tdl 自身的会话/登录态（若被放在项目内）
.tdl/

# 个人凭据 / 密钥类文件（防止误加）
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
.env
.env.*
!/.env.example

# ============================================================
#  依赖与构建产物 —— 可重新生成
# ============================================================

gui/node_modules/
node_modules/
npm-debug.log*
yarn-error.log*

# 本地安装的启动器会写入绝对路径（个人路径，不入库）
gui/bin/tdlw.path

# ============================================================
#  预编译二进制 —— 体积大且可重新构建
# ============================================================
# tools/tdlinfo、tools/tdlsession 的源码在仓库内，.exe 可用 go build 重新生成，
# 因此不入库（如需免编译分发，可改为放开下面两行）。
gui/tools/**/*.exe
gui/tools/**/tdlinfo
gui/tools/**/tdlsession

# tdl 官方发行版（47MB，可从上游 Release 重新下载，非本项目代码）
tdl_Windows_64bit/

# 上游 tdl 的源码快照（参考用，可从 https://github.com/iyear/tdl 重新获取）
# 本项目自己的代码在 gui/；如需把上游源码也纳入版本管理，删掉下面这行即可。
tdl_source/

# ============================================================
#  编辑器 / 系统 / 工具
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
.mimosa/
.gitignore.bak
